[Unit]
Description=TezPOS Telegram smena sync (background, no overlap)
After=network.target tezpos-site.service

[Service]
Type=oneshot
RemainAfterExit=no
User=www-data
Group=www-data
WorkingDirectory=/opt/tezpos_site
EnvironmentFile=/opt/tezpos_site/.env
TimeoutStartSec=180
ExecStart=/opt/tezpos_site/.venv/bin/python /opt/tezpos_site/manage.py sync_telegram_shifts
Nice=10
