# Nusxa: cp .env.example .env  va qiymatlarni to'ldiring
DEBUG=0
SECRET_KEY=bu-yerni-uzun-tasodifiy-kalit-bilan-almashtiring-min-50-belgi
ALLOWED_HOSTS=tez-pos.uz,www.tez-pos.uz
CSRF_TRUSTED_ORIGINS=https://tez-pos.uz,https://www.tez-pos.uz
USE_HTTPS=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# TezPOS API (desktop backend) — saytning o'zi emas!
# Contabo da backend bilan bir serverda bo'lsa: http://127.0.0.1:8000
TEZPOS_API_URL=http://127.0.0.1:8000

# DevSMS (qarz/to'lov SMS) — TezPOS Sozlamalaridagi token
DEVSMS_TOKEN=
DEVSMS_FROM=4546

# Ixtiyoriy
# SQLITE_PATH=/opt/tezpos_site/db.sqlite3
# MEDIA_ROOT=/opt/tezpos_site/media
